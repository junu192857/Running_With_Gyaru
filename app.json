{
  "expo": {
    "name": "Running With Gyaru",
    "slug": "running-with-gyaru",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "runningwithgyaru",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "달리는 동안 거리와 페이스를 측정하기 위해 위치 정보를 사용합니다.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.local.runningwithgyaru",
      "infoPlist": {
        "UIBackgroundModes": ["location", "audio"]
      }
    },
    "android": {
      "package": "dev.local.runningwithgyaru",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
